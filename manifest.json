{
  "manifest_version": 3,
  "name": "PII Guard — Privacy Warning",
  "version": "1.0.0",
  "description": "Warns you when you type common personally identifiable information into web forms.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["patterns.js", "context-analyzer.js", "detection-engine.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["styles.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "PII Guard",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}